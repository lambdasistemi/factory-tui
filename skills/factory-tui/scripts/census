#!/usr/bin/env bash
# List live tmux sessions, windows and panes, for writing reinterpreters.
set -euo pipefail

if [ -z "${TMUX:-}" ]; then
  echo "census: not inside tmux" >&2
  exit 1
fi

printf 'session\twindow\tpane\ttitle\n'
tmux list-panes -a -F '#{session_name}	#{window_name}	#{pane_id}	#{pane_title}' | sort
